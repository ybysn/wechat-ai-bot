{
  "schema_version": 2,
  "app": {
    "auto_send": false
  },
  "agent_wechat": {
    "base_url": "http://127.0.0.1:6174/v1",
    "account_id": "replace-with-account-id",
    "target_group_id": "replace-with-group-id@chatroom",
    "consumer_name": "wechat-ai-bot-observer",
    "token_file": "/config/agent-wechat-token"
  },
  "storage": {
    "database": "/state/bot.sqlite3"
  },
  "processing": {
    "max_message_chars": 4000,
    "max_context_messages": 12
  },
  "safety": {
    "group_allowlist": [
      "replace-with-group-id@chatroom"
    ]
  },
  "sender": {
    "enabled": false
  },
  "runtime": {
    "global_pause": true
  },
  "llm": {
    "provider": "deepseek",
    "deepseek": {
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-flash",
      "api_key_file": "/config/deepseek-api-key",
      "usage_log_file": "/state/deepseek-usage.jsonl",
      "daily_request_limit": 50,
      "timeout_seconds": 45
    }
  }
}
