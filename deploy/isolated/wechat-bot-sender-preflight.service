[Unit]
Description=WX Chat Bot isolated Sender preflight (read only)

[Service]
Type=oneshot
User=wechat-sender
Group=wechat-sender
SupplementaryGroups=wechat-store
WorkingDirectory=/opt/wechat-ai-bot
Environment=PYTHONPATH=/opt/wechat-ai-bot/src
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -P -u -m wechat_ai_bot.sender_dry_run --config /etc/wechat-ai-bot/observer.json --automatic-policy /etc/wechat-ai-bot/automatic-reply.json --isolated-worker
UMask=0077
ProtectHome=yes
ProtectSystem=strict
InaccessiblePaths=/var/lib/wechat-ai-bot/observer /var/lib/wechat-ai-bot/sender
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
