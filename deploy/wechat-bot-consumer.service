[Unit]
Description=WX Chat Bot - Durable Agent WeChat SSE Consumer
Wants=agent-wechat-native.service
After=agent-wechat-native.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/apps/wechat-ai-bot
Environment=PYTHONPATH=%h/apps/wechat-ai-bot/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m wechat_ai_bot.consumer
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=5
TimeoutStopSec=50
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=default.target
